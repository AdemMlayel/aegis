# AegisQA local/demo configuration
# Defaults use real local models and do not contact company APIs.

AEGISQA_ENV=local
# Use this for PM demos when Ollama is not installed/running.
# true => demo ticket + mock LLM + local hash embeddings + mock execution.
AEGISQA_DETERMINISTIC_DEMO_MODE=false
AEGISQA_AUTH_MODE=permissive
AEGISQA_LOCAL_USER=local-user
AEGISQA_LOCAL_ROLE=qa_lead
# AEGISQA_SQLITE_DB_PATH=C:/path/to/aegisqa.sqlite3
AEGISQA_STORAGE_BACKEND=sqlite
# Future placeholder only; PostgreSQL adapter is intentionally disabled until migrations are implemented.
# AEGISQA_DATABASE_URL=postgresql://user:password@localhost:5432/aegisqa
# AEGISQA_GENERATED_ROOT=C:/path/to/aegisqa-generated
# Optional local folder containing .md/.txt/.rst files for RAG ingestion.
# AEGISQA_KNOWLEDGE_DOCUMENTS_DIR=C:/path/to/aegisqa-knowledge

# Provider selections
AEGISQA_DEFAULT_TICKET_CONNECTOR=jira_mock
AEGISQA_DEFAULT_EXECUTION_ADAPTER=robot
# Optional: robot_docker uses Docker isolation if Docker and the image are available.
AEGISQA_ROBOT_DOCKER_IMAGE=aegisqa-robot-runner:local
AEGISQA_ROBOT_DOCKER_TIMEOUT_SECONDS=180
AEGISQA_DEFAULT_ARTIFACT_STORE=local_fs
AEGISQA_DEFAULT_SECRET_PROVIDER=mock_vault
AEGISQA_EXTERNAL_CONNECTORS_ENABLED=false

# AI / RAG / memory local mode
AEGISQA_DEFAULT_LLM_PROVIDER=ollama
AEGISQA_DEFAULT_EMBEDDING_PROVIDER=ollama_nomic_embed_text
AEGISQA_DEFAULT_KNOWLEDGE_STORE=local_knowledge
AEGISQA_DEFAULT_MEMORY_STORE=local_episodic_memory

# Ollama local model mode
# Start Ollama and pull these models before selecting ollama providers:
#   ollama pull qwen3:3b
#   ollama pull llama3.1:8b
#   ollama pull qwen3-coder
#   ollama pull phi4-mini
#   ollama pull gemma3:4b
#   ollama pull deepseek-r1:8b
#   ollama pull deepseek-r1:7b
#   ollama pull qwen3-embedding:0.6b
#   ollama pull nomic-embed-text
AEGISQA_OLLAMA_BASE_URL=http://127.0.0.1:11434
AEGISQA_OLLAMA_CHAT_MODEL=qwen3:3b
AEGISQA_OLLAMA_RAG_MODEL=qwen3:3b
AEGISQA_OLLAMA_BASELINE_MODEL=llama3.1:8b
AEGISQA_OLLAMA_CODING_MODEL=qwen3-coder
AEGISQA_OLLAMA_FAST_MODEL=phi4-mini
AEGISQA_OLLAMA_FAST_FALLBACK_MODEL=gemma3:4b
AEGISQA_OLLAMA_REASONING_MODEL=deepseek-r1:8b
AEGISQA_OLLAMA_REASONING_FALLBACK_MODEL=deepseek-r1:7b
AEGISQA_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
AEGISQA_OLLAMA_EMBEDDING_FALLBACK_MODEL=nomic-embed-text
AEGISQA_OLLAMA_TIMEOUT_SECONDS=20
AEGISQA_OLLAMA_DISCOVERY_TIMEOUT_SECONDS=2
AEGISQA_LLM_HTTP_TIMEOUT_SECONDS=20
AEGISQA_OLLAMA_TEMPERATURE=0.1
# Automated tests override these selections with deterministic providers.

# Optional OpenAI-compatible provider. Credentials stay on the API server and
# are never sent to the dashboard. All four LLM-backed agents can select this
# provider independently after external connectors are enabled.
# AEGISQA_EXTERNAL_CONNECTORS_ENABLED=true
# AEGISQA_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# AEGISQA_OPENAI_COMPATIBLE_API_KEY=
# AEGISQA_OPENAI_COMPATIBLE_CHAT_MODEL=gpt-4o-mini

# Strict local auth option for developer demos:
# AEGISQA_AUTH_MODE=strict
# AEGISQA_DEV_TOKEN=dev-only-token
# AEGISQA_TOKEN_USER=token-user
# AEGISQA_TOKEN_ROLE=qa_lead

# Gateway governance and observability
AEGISQA_GATEWAY_REQUESTS_PER_MINUTE=240
AEGISQA_GATEWAY_DAILY_REQUEST_QUOTA=10000
AEGISQA_GATEWAY_REQUEST_TIMEOUT_SECONDS=60
AEGISQA_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
AEGISQA_PROVIDER_CIRCUIT_RESET_SECONDS=30
AEGISQA_AGENT_MAX_MODEL_CALLS_PER_WORKFLOW=24
AEGISQA_AGENT_MAX_TOKENS_PER_CALL=16000
AEGISQA_AGENT_MAX_TOKENS_PER_WORKFLOW=120000
AEGISQA_ORGANIZATION_DAILY_TOKEN_QUOTA=1000000
AEGISQA_TOKEN_RESERVATION_TTL_SECONDS=300
AEGISQA_EXTERNAL_INPUT_COST_PER_1K=0.00015
AEGISQA_EXTERNAL_OUTPUT_COST_PER_1K=0.0006
AEGISQA_OBSERVABILITY_ERROR_RATE_THRESHOLD=0.05
AEGISQA_OBSERVABILITY_AGENT_FAILURE_RATE_THRESHOLD=0.10

# Optional durable execution worker
AEGISQA_EXECUTION_WORKER_BACKEND=local
AEGISQA_EXECUTION_WORKER_BATCH_SIZE=10
AEGISQA_EXECUTION_WORKER_POLL_INTERVAL_SECONDS=1
AEGISQA_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
AEGISQA_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
AEGISQA_CELERY_EXECUTION_TASK=aegisqa.execution.process_run
AEGISQA_CELERY_FALLBACK_TO_LOCAL=true
