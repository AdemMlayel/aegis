# AegisQA runtime configuration example.
# Copy to `.env` (gitignored) and fill in real values. NEVER commit `.env`.

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# Deterministic demo mode forces safe local/mock providers (mock_llm,
# local_hash_embeddings, mock execution). Set to false to run on real models.
AEGISQA_DETERMINISTIC_DEMO_MODE=false

# Allow external (cloud) providers such as openai_compatible to be selectable.
AEGISQA_EXTERNAL_CONNECTORS_ENABLED=true

# ---------------------------------------------------------------------------
# Default LLM provider: one of mock_llm | ollama | openai_compatible
# ---------------------------------------------------------------------------
AEGISQA_DEFAULT_LLM_PROVIDER=openai_compatible

# --- Cloud / OpenAI-compatible (OpenAI, vLLM, any /v1 gateway) ---
# For OpenAI: base url https://api.openai.com/v1 and a real sk-... key.
# For vLLM: your server's /v1 url; any key string; set the context window so
# prompt+max_tokens never exceeds max_model_len (otherwise the server returns
# HTTP 400 and the agent silently falls back to mock). 0 disables clamping.
AEGISQA_OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
AEGISQA_OPENAI_COMPATIBLE_API_KEY=sk-REPLACE_ME
AEGISQA_OPENAI_COMPATIBLE_CHAT_MODEL=gpt-4o-mini
AEGISQA_OPENAI_COMPATIBLE_CONTEXT_WINDOW=0
AEGISQA_OPENAI_COMPATIBLE_MIN_OUTPUT_TOKENS=256

# --- Local / Ollama (private, offline) ---
# Install Ollama, `ollama pull <model>`, then point these at it.
# Pick models that fit the host's RAM/GPU. Small CPU box example: qwen2.5:0.5b.
AEGISQA_OLLAMA_BASE_URL=http://127.0.0.1:11434
AEGISQA_OLLAMA_CHAT_MODEL=qwen2.5:3b
AEGISQA_OLLAMA_RAG_MODEL=qwen2.5:3b
AEGISQA_OLLAMA_REASONING_MODEL=deepseek-r1:8b
AEGISQA_OLLAMA_BASELINE_MODEL=llama3.1:8b

# ---------------------------------------------------------------------------
# Chat copilot LLM layers
# ---------------------------------------------------------------------------
# When enabled (and a real provider is configured), the copilot uses the LLM to
# (1) adjudicate ambiguous intents the rules score weakly, and (2) answer
# free-form questions grounded in system knowledge + RAG. Off / no-op in demo
# mode and with the mock provider, so behavior stays deterministic by default.
AEGISQA_CHAT_LLM_FALLBACK_ENABLED=true
AEGISQA_CHAT_LLM_MAX_OUTPUT_TOKENS=512

# ---------------------------------------------------------------------------
# Embeddings: local_hash_embeddings (no model) | ollama_nomic_embed_text
# ---------------------------------------------------------------------------
AEGISQA_DEFAULT_EMBEDDING_PROVIDER=local_hash_embeddings

# ---------------------------------------------------------------------------
# Execution adapter: robot | mock
# ---------------------------------------------------------------------------
AEGISQA_DEFAULT_EXECUTION_ADAPTER=robot
